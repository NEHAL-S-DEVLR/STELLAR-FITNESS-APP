{
  "buildCommand": "npm install && npm run build && cd backend && npm install",
  "functions": {
    "backend/api/index.js": {
      "maxDuration": 15,
      "memory": 512,
      "includeFiles": "out/**"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/backend/api/index" }
  ]
}
