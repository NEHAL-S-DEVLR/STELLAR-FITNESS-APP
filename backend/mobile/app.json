{
  "expo": {
    "name": "Stellar Fitness Club",
    "slug": "stellar-fitness-club",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "newArchEnabled": true,
    "platforms": [
      "ios",
      "android"
    ],
    "splash": {
      "backgroundColor": "#000000",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stellarfitnessclub.app",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSCameraUsageDescription": "Used to scan the gym's check-in QR code and member verification codes."
      }
    },
    "android": {
      "package": "com.stellarfitnessclub.app",
      "adaptiveIcon": {
        "backgroundColor": "#1D4ED8"
      },
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Used to scan the gym's check-in QR code and member verification codes."
        }
      ]
    ]
  }
}
